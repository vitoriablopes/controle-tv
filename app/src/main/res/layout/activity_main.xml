<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:id="@+id/remoteScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <!-- cabeçalho: TV + estado + configurações do app -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_borderless"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/dot_off" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvName"
                            style="@style/Text.Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1" />

                        <TextView
                            android:id="@+id/statusText"
                            style="@style/Text.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnAppSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_borderless"
                    android:contentDescription="@string/app_settings"
                    android:src="@drawable/ic_more" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- ligar / entradas / configurações da TV -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/power"
                        layout="@layout/item_round_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/inputs"
                        layout="@layout/item_round_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/tvSettings"
                        layout="@layout/item_round_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- atalhos de streaming -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shortcuts" />

                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/shortcuts_hint" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/shortcutRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />

                <!-- direcional -->
                <FrameLayout
                    android:layout_width="252dp"
                    android:layout_height="252dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_dpad">

                    <ImageButton
                        android:id="@+id/dpadUp"
                        android:layout_width="84dp"
                        android:layout_height="80dp"
                        android:layout_gravity="top|center_horizontal"
                        android:background="@drawable/bg_borderless"
                        android:contentDescription="@string/btn_up"
                        android:scaleType="center"
                        android:src="@drawable/ic_chevron_up" />

                    <ImageButton
                        android:id="@+id/dpadDown"
                        android:layout_width="84dp"
                        android:layout_height="80dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:background="@drawable/bg_borderless"
                        android:contentDescription="@string/btn_down"
                        android:rotation="180"
                        android:scaleType="center"
                        android:src="@drawable/ic_chevron_up" />

                    <ImageButton
                        android:id="@+id/dpadLeft"
                        android:layout_width="80dp"
                        android:layout_height="84dp"
                        android:layout_gravity="start|center_vertical"
                        android:background="@drawable/bg_borderless"
                        android:contentDescription="@string/btn_left"
                        android:rotation="270"
                        android:scaleType="center"
                        android:src="@drawable/ic_chevron_up" />

                    <ImageButton
                        android:id="@+id/dpadRight"
                        android:layout_width="80dp"
                        android:layout_height="84dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@drawable/bg_borderless"
                        android:contentDescription="@string/btn_right"
                        android:rotation="90"
                        android:scaleType="center"
                        android:src="@drawable/ic_chevron_up" />

                    <TextView
                        android:id="@+id/dpadOk"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_round_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/open_sans_semibold"
                        android:gravity="center"
                        android:text="@string/btn_ok"
                        android:textColor="@color/text"
                        android:textSize="18sp" />
                </FrameLayout>

                <!-- voltar / início / menu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/back"
                        layout="@layout/item_round_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/home"
                        layout="@layout/item_round_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/menu"
                        layout="@layout/item_round_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- volume / mudo / play-pausa -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="60dp"
                            android:background="@drawable/bg_pill"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/volDown"
                                android:layout_width="56dp"
                                android:layout_height="60dp"
                                android:background="@drawable/bg_borderless"
                                android:contentDescription="@string/btn_vol_down"
                                android:src="@drawable/ic_remove" />

                            <TextView
                                android:id="@+id/volumeText"
                                style="@style/Text"
                                android:layout_width="40dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/open_sans_semibold"
                                android:gravity="center"
                                android:text="@string/volume"
                                android:textSize="13sp" />

                            <ImageButton
                                android:id="@+id/volUp"
                                android:layout_width="56dp"
                                android:layout_height="60dp"
                                android:background="@drawable/bg_borderless"
                                android:contentDescription="@string/btn_vol_up"
                                android:src="@drawable/ic_add" />
                        </LinearLayout>

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/volume" />
                    </LinearLayout>

                    <include
                        android:id="@+id/mute"
                        layout="@layout/item_round_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8" />

                    <include
                        android:id="@+id/playPause"
                        layout="@layout/item_round_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- sem TV pareada -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.8"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_tv" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/no_tv_title" />

        <TextView
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/no_tv_text"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPair"
            style="@style/Button.Filled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/search_tvs" />
    </LinearLayout>
</FrameLayout>
